    "html": "<!DOCTYPE html><html><head>\n\t\t<meta charset=\"UTF-8\">\n\t\t<meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n\t\t<title>ParaBank | Welcome | Online Banking</title>\n\t\t<link href=\"template.css;jsessionid=5F4300B7ADB762F9D95092F361392500\" rel=\"stylesheet\" type=\"text/css\">\n\t\t<link href=\"style.css;jsessionid=5F4300B7ADB762F9D95092F361392500\" rel=\"stylesheet\" type=\"text/css\">\n\t\t<script src=\"webjars/jquery/4.0.0/jquery.min.js;jsessionid=5F4300B7ADB762F9D95092F361392500\"></script>\n\t</head>\n\n\t<body onload=\"document.login.username.focus();\">\n\t\t<div id=\"mainPanel\">\n\t\t\t\n\t\t\t\t\n\t\t\t\t\t\n\n\n\n<div id=\"topPanel\">\n  <a href=\"admin.htm;jsessionid=5F4300B7ADB762F9D95092F361392500\"><img src=\"images/clear.gif;jsessionid=5F4300B7ADB762F9D95092F361392500\" width=\"56\" height=\"42\" border=\"0\" class=\"admin\"></a>\n  <a href=\"index.htm;jsessionid=5F4300B7ADB762F9D95092F361392500\"><img src=\"images/logo.gif;jsessionid=5F4300B7ADB762F9D95092F361392500\" alt=\"ParaBank\" width=\"136\" height=\"31\" border=\"0\" class=\"logo\" title=\"ParaBank\"></a>\n  <p class=\"caption\">Experience the difference</p>\n</div>\n<div id=\"headerPanel\" style=\"background: url(images/header-main.jpg;jsessionid=5F4300B7ADB762F9D95092F361392500) 0 0 no-repeat;\">\n  \n\n\n<ul class=\"leftmenu\">\n  <li class=\"Solutions\">Solutions</li>\n  <li><a href=\"about.htm;jsessionid=5F4300B7ADB762F9D95092F361392500\">About Us</a></li>\n  <li><a href=\"services.htm;jsessionid=5F4300B7ADB762F9D95092F361392500\">Services</a></li>\n  <li><a href=\"http://www.parasoft.com/jsp/products.jsp\">Products</a></li>\n  <li><a href=\"http://www.parasoft.com/jsp/pr/contacts.jsp\">Locations</a></li>\n  <li><a href=\"admin.htm;jsessionid=5F4300B7ADB762F9D95092F361392500\">Admin Page</a></li>\n  \n</ul>\n  \n\n\n<ul class=\"button\">\n  <li class=\"home\"><a href=\"index.htm;jsessionid=5F4300B7ADB762F9D95092F361392500\">home</a></li>\n  <li class=\"aboutus\"><a href=\"about.htm;jsessionid=5F4300B7ADB762F9D95092F361392500\">about</a></li>\n  <li class=\"contact\"><a href=\"contact.htm;jsessionid=5F4300B7ADB762F9D95092F361392500\">contact</a></li>\n</ul>\n</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t\n\t\t\t<div id=\"bodyPanel\">\n\t\t\t\t<div id=\"leftPanel\">\n\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\n\n<h2>Customer Login</h2>\n<div id=\"loginPanel\">\n  <form name=\"login\" action=\"login.htm;jsessionid=5F4300B7ADB762F9D95092F361392500\" method=\"POST\">\n    \n    <p><b>Username</b></p>\n    <div class=\"login\"><input type=\"text\" class=\"input\" name=\"username\"></div>\n    <p><b>Password</b></p>\n    <div class=\"login\"><input type=\"password\" class=\"input\" name=\"password\"></div>\n    <div class=\"login\"><input type=\"submit\" class=\"button\" value=\"Log In\"></div>\n  </form>\n  <p><a href=\"lookup.htm;jsessionid=5F4300B7ADB762F9D95092F361392500\">Forgot login info?</a></p>\n  <p><a href=\"register.htm;jsessionid=5F4300B7ADB762F9D95092F361392500\">Register</a></p>\n</div>\n\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t<div id=\"rightPanel\">\n\t\t\t\t\t\n\n\n<span class=\"services\">&nbsp;</span>\n<ul class=\"services\">\n  \n  <li class=\"captionone\">ATM Services</li>\n  <li><a href=\"services/ParaBank;jsessionid=5F4300B7ADB762F9D95092F361392500?wsdl\">Withdraw Funds</a></li>\n  <li><a href=\"services/ParaBank;jsessionid=5F4300B7ADB762F9D95092F361392500?wsdl\">Transfer Funds</a></li>\n  <li><a href=\"services/ParaBank;jsessionid=5F4300B7ADB762F9D95092F361392500?wsdl\">Check Balances</a></li>\n  <li><a href=\"services/ParaBank;jsessionid=5F4300B7ADB762F9D95092F361392500?wsdl\">Make Deposits</a></li>\n</ul>\n<ul class=\"servicestwo\">\n  \n  <li class=\"captiontwo\">Online Services</li>\n  <li><a href=\"services/bank;jsessionid=5F4300B7ADB762F9D95092F361392500?_wadl&amp;_type=xml\">Bill Pay</a></li>\n  <li><a href=\"services/bank;jsessionid=5F4300B7ADB762F9D95092F361392500?_wadl&amp;_type=xml\">Account History</a></li>\n  <li><a href=\"services/bank;jsessionid=5F4300B7ADB762F9D95092F361392500?_wadl&amp;_type=xml\">Transfer Funds</a></li>\n</ul>\n<p class=\"more\"><a href=\"services.htm;jsessionid=5F4300B7ADB762F9D95092F361392500\">Read More</a></p>\n<h4>Latest News</h4>\n<ul class=\"events\">\n  <li class=\"captionthree\">10/15/2026</li>\n  \n    <li><a href=\"news.htm;jsessionid=5F4300B7ADB762F9D95092F361392500#6\">ParaBank Is Now Re-Opened</a></li>\n  \n    <li><a href=\"news.htm;jsessionid=5F4300B7ADB762F9D95092F361392500#5\">New! Online Bill Pay</a></li>\n  \n    <li><a href=\"news.htm;jsessionid=5F4300B7ADB762F9D95092F361392500#4\">New! Online Account Transfers</a></li>\n  \n</ul>\n<p class=\"more\"><a href=\"news.htm;jsessionid=5F4300B7ADB762F9D95092F361392500\">Read More</a></p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t\n\n\n<div id=\"footermainPanel\">\n  <div id=\"footerPanel\">\n    <ul>\n      <li><a href=\"index.htm;jsessionid=5F4300B7ADB762F9D95092F361392500\">Home</a>| </li>\n      <li><a href=\"about.htm;jsessionid=5F4300B7ADB762F9D95092F361392500\">About Us</a>| </li>\n      <li><a href=\"services.htm;jsessionid=5F4300B7ADB762F9D95092F361392500\">Services</a>| </li>\n      <li><a href=\"http://www.parasoft.com/jsp/products.jsp\">Products</a>| </li>\n      <li><a href=\"http://www.parasoft.com/jsp/pr/contacts.jsp\">Locations</a>| </li>\n      <li><a href=\"sitemap.htm;jsessionid=5F4300B7ADB762F9D95092F361392500\">Site Map</a>| </li>\n      <li><a href=\"contact.htm;jsessionid=5F4300B7ADB762F9D95092F361392500\">Contact Us</a></li>\n    </ul>\n    <p class=\"copyright\">\u00a9 Parasoft. All rights reserved.</p>\n    <ul class=\"visit\">\n      <li>Visit us at:</li>\n      <li><a href=\"http://www.parasoft.com/\" target=\"_blank\">www.parasoft.com</a></li>\n    </ul>\n  </div>\n</div>\n\t\n\n</body></html>",
