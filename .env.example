# Copy to .env and fill in. Never commit .env.
# Local ParaBank (docker compose up -d). Public demo: https://parabank.parasoft.com/parabank (often slow or broken)
BASE_URL=http://localhost:8080/parabank
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
LLM_PROVIDER=ollama
# Optional hosted API (not required)
# ANTHROPIC_API_KEY=
EXPECT_TIMEOUT_MS=10000
ACTION_TIMEOUT_MS=15000
